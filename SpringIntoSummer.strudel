await initHydra()

solid(0.9, 0.95, 0.7)
  .add(osc(6, 0.05, 0.2).color(0.85, 0.9, 0.6), 0.15)
  .modulate(noise(2, 0.3))
  .out()

setcps(95/60/4)

stack(
  note("d4 f#4 a4 d5 a4 f#4 e4 d4")
    .sound("sine")
    .decay(0.1)
    .sustain(0)
    .room(0.4)
    .gain(perlin.range(0.6, 1.0)),

  sound("hh _ _ hh _ hh _ _")
    .gain(0.4),
  
  note("<[d4,f#4,a4] [a3,e4,a4] [b3,d4,f#4] [g3,b3,d4]>")
  .sound("triangle")
  .gain(0.3)
  .room(0.5),

  note("d5 f#5 a5 d6")
  .sound("sine")
  .fast(2)
  .decay(0.05)
  .sustain(0)
  .speed(perlin.range(0.8, 1.4))
  .gain(perlin.range(0.2, 0.6))
  .delay(0.4)
  .delaytime(0.125)
  .pan(sine)
  .jux(rev), 

  sound("bd ~ ~ ~ bd ~ ~ ~")
    .bank("RolandTR808")
    .gain(0.7), 

  note("<d1 a1 b1 g1>")
    .sound("sine")
    .gain(0.8)
    .krush(4)
)